msgstr "Se ha enviado un código de verificación a su correo electrónico."

#: appels/views.py:122
msgid "Une erreur est survenue lors de l'envoie. Réessayez"
msgstr "Se produjo un error durante el envío. Intentar otra vez"

#: appels/views.py:125
msgid ""
"Cet utilisateur n'existe pas ou n'est pas un enseignant verifier l'email"
msgstr "Este usuario no existe o no es profesor consultar email"

#: appels/views.py:141
msgid "Session expirée ou invalide. Veullez recommencer"
msgstr "La sesión expiró o no es válida. Por favor empieza de nuevo"

#: appels/views.py:155
msgid "code validé avec succes"
msgstr "código validado exitosamente"

#: appels/views.py:158
msgid "Code incorrect.Veuillez réesayer"
msgstr "Código incorrecto. Por favor inténtalo de nuevo"

#: appels/views.py:177
msgid "Mot de passe réinitialisé avec succès ! vous pouvez vous connectez"
msgstr "¡Restablecimiento de contraseña exitoso! puedes iniciar sesión"

#: appels/views.py:180
msgid "Utilisateur introuvable"
msgstr "Usuario no encontrado"

#: appels/views.py:215
#, python-brace-format
msgid "La matière {matiere.nom} a été créée"
msgstr "El material {material.name} ha sido creado"

#: appels/views.py:235
#, python-brace-format
msgid "La matiere {matiere.nom} a été mise à jour"
msgstr "El material {material.name} ha sido actualizado"

#: appels/views.py:248
msgid "Matiere suppriméé definitivement."
msgstr "Material eliminado permanentemente."

#: appels/views.py:264
#, python-brace-format
msgid ""
"La matière {matiere.nom} a été réinitialisée : historique et étudiants "
"effacés."
msgstr ""
"La materia {subject.name} se ha restablecido: historial y estudiantes "
"eliminados."

#: appels/views.py:391
msgid "Cet étudiant n'appartient pas à cette école."
msgstr "Este estudiante no pertenece a esta escuela."

#: appels/views.py:399
#, python-brace-format
msgid "{etudiant.first_name} est maintenant inscrit à {matiere.nom}"
msgstr "{etudiant.first_name} ahora está registrado en {matiere.name}"

#: appels/views.py:401
#, python-brace-format
msgid "{etudiant.first_name} etait déja inscrit"
msgstr "{etudiant.first_name} ya estaba registrado"

#: appels/views.py:463
msgid "Le temps est écoulé, l'appel a été clôturé automatiquement."
msgstr "Se acabó el tiempo, la convocatoria se ha cerrado automáticamente."

#: appels/views.py:481
msgid "Cet appel a déjà été généré."
msgstr "Esta llamada ya ha sido generada."

#: appels/views.py:509
#, python-brace-format
msgid "Appel lancé ! Le code est : {code}"
msgstr "¡Convocatoria lanzada! El código es: {código}"

#: appels/views.py:522
msgid "L'appel est maintenant clôturé et les absences ont été comptabilisées."
msgstr "La convocatoria ya está cerrada y se han contabilizado las ausencias."

#: appels/views.py:580
#, python-brace-format
msgid ""
"La séance du {date_feuille} a été supprimée et les compteurs ont été mis à "
"jour."
msgstr ""
"Se eliminó la sesión de {date_feuille} y se actualizaron los contadores."

#: appels/views.py:592
#, python-brace-format
msgid ""
"L'historique a été vidé ({nb_seances} séances supprimées). Les statistiques "
"des étudiants sont réinitialisées."
msgstr ""
"El historial se ha vaciado ({nb_sessions} sesiones eliminadas). Se "
"restablecen las estadísticas de los estudiantes."

#: appels/views.py:686
msgid "Compte étudiant créé!"
msgstr "¡Cuenta de estudiante creada!"

#: appels/views.py:741
msgid "Accès refusé : tu n'as pas de profil étudiant."
msgstr "Acceso denegado: no tienes perfil de estudiante."

#: appels/views.py:744
msgid "Accès refusé : vous ne faites pas partie de cette ecole."
msgstr "Acceso denegado: no eres parte de esta escuela."

#: appels/views.py:752
#, python-brace-format
msgid "Felicitations : tu es maintenant inscrire au cour de {matiere.nom}"
msgstr "Felicitaciones: ya está registrado en {matiere.name}"

#: appels/views.py:754
#, python-brace-format
msgid "Tu es déja inscrit au cour de {matiere.nom}"
msgstr "Ya estás registrado en {subject.name}"

#: appels/views.py:768
msgid "Format du lien invalide ou non autorisé."
msgstr "Formato de enlace no válido o no autorizado."

#: appels/views.py:770
msgid "Impossible d'analyser le lien fourni."
msgstr "No se puede analizar el enlace proporcionado."

#: appels/views.py:797
msgid "Désolé l'appel est terminé veuillez consulter votre enseignant."
msgstr ""
"Lamentamos que la llamada haya finalizado por favor consulta a tu profesor."

#: appels/views.py:801
msgid "Localisation GPS requise pour valider."
msgstr "Se requiere ubicación GPS para validar."

#: appels/views.py:810
msgid ""
"Tu es trop loin de l'enseignant ({int(distance)}m). Signaler à l'enseignant "
"en cas d'erreur"
msgstr ""
"Estás demasiado lejos del profesor ({int(distancia)}m). Informar al profesor"
" en caso de error."

#: appels/views.py:823
msgid "Presence validéé avec succès !"
msgstr "¡Asistencia validada exitosamente!"

#: appels/views.py:825
msgid "Tu es déjà marqué(e) present"
msgstr "Ya estas marcado presente"

#: appels/views.py:827
msgid "code incorrect ou session expirée."
msgstr "código incorrecto o sesión caducada."

